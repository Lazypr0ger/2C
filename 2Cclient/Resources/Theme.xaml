<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brushes -->
    <SolidColorBrush x:Key="Success">#49D17C</SolidColorBrush>
    <SolidColorBrush x:Key="Danger">#FF5A5A</SolidColorBrush>
    <SolidColorBrush x:Key="DangerRowBg">#2A1212</SolidColorBrush>
    <SolidColorBrush x:Key="Warning">#FFD166</SolidColorBrush>
    <SolidColorBrush x:Key="Bg">#0E1116</SolidColorBrush>
    <SolidColorBrush x:Key="Panel">#141A22</SolidColorBrush>
    <SolidColorBrush x:Key="Panel2">#10151C</SolidColorBrush>
    <SolidColorBrush x:Key="Text">#E6E9EF</SolidColorBrush>
    <SolidColorBrush x:Key="Text2">#AAB3C2</SolidColorBrush>
    <SolidColorBrush x:Key="Accent">#4DA3FF</SolidColorBrush>

    <!-- Nav ListBox -->
    <Style x:Key="NavListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Nav Item (активный/hover) -->
    <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="14,0,14,0"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Акцентная полоска -->
                            <Border x:Name="Bar"
                                    Grid.Column="0"
                                    Background="Transparent"
                                    CornerRadius="10,0,0,10"/>

                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1B2430"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#223046"/>
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Accent}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- SearchBox -->
    <Style x:Key="SearchBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="#0F141B"/>
        <Setter Property="BorderBrush" Value="#243142"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,0,12,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>

                            <!-- Watermark -->
                            <TextBlock x:Name="Watermark"
                                       Text="Поиск…"
                                       Foreground="{StaticResource Text2}"
                                       Margin="12,0,12,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Form TextBox (base, без watermark, без стандартного validation adorner) -->
    <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="#0F141B"/>
        <Setter Property="BorderBrush" Value="#243142"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,0,12,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <!-- убираем стандартный validation adorner -->
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <AdornedElementPlaceholder/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>

                        <!-- стандартная подсветка ошибки (если кто-то использует Validation.HasError) -->
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ✅ NEW: Validated TextBox (modern): красная рамка + tooltip из Validation.Errors -->
    <Style x:Key="FormTextBoxValidatedStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip Content="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"
                         Background="#1B2430"
                         Foreground="{StaticResource Text}"
                         BorderBrush="{StaticResource Danger}"
                         BorderThickness="1"
                         Padding="10,6"
                         Placement="Bottom"
                         HasDropShadow="True"/>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                <Setter Property="ToolTipService.IsEnabled" Value="True"/>
            </Trigger>

            <Trigger Property="Validation.HasError" Value="False">
                <Setter Property="ToolTipService.IsEnabled" Value="False"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Toolbar buttons -->
    <Style x:Key="ToolbarButtonBase" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="#0F141B"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="#243142"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary (Добавить) -->
    <Style x:Key="ToolbarButtonPrimary" TargetType="Button" BasedOn="{StaticResource ToolbarButtonBase}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="#0E1116"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Danger (Удалить) -->
    <Style x:Key="ToolbarButtonDanger" TargetType="Button" BasedOn="{StaticResource ToolbarButtonBase}">
        <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
        <Setter Property="Background" Value="#0F141B"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="True">
                <Setter Property="Background" Value="{StaticResource Danger}"/>
                <Setter Property="Foreground" Value="#0E1116"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#0F141B"/>
                <Setter Property="Foreground" Value="#B86A6A"/>
                <Setter Property="BorderBrush" Value="#5A2A2A"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Restore (Восстановить) -->
    <Style x:Key="ToolbarButtonSuccess" TargetType="Button" BasedOn="{StaticResource ToolbarButtonBase}">
        <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
        <Setter Property="Foreground" Value="{StaticResource Success}"/>
        <Setter Property="Background" Value="#0F141B"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="True">
                <Setter Property="Background" Value="{StaticResource Success}"/>
                <Setter Property="Foreground" Value="#0E1116"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#0F141B"/>
                <Setter Property="Foreground" Value="#6AB88A"/>
                <Setter Property="BorderBrush" Value="#2A5A3A"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Row delete button -->
    <Style x:Key="RowDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonDanger}">
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Content" Value="✕"/>
    </Style>

    <!-- Dark ComboBox (фикс: показываем выбранное через ComboBox.Text) -->
    <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="12,0,12,0"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="#0F141B"/>
        <Setter Property="BorderBrush" Value="#243142"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <!-- ✅ Selected text always visible -->
                                <Grid Grid.Column="0" Margin="{TemplateBinding Padding}">
                                    <TextBlock x:Name="SelectedText"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{TemplateBinding Text}"/>

                                    <TextBlock x:Name="Placeholder"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Text2}"
                                           Text="—"
                                           Visibility="Collapsed"/>
                                </Grid>

                                <ToggleButton Grid.Column="1"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0">
                                    <Path Data="M 0 0 L 6 6 L 12 0 Z"
                                      Fill="{StaticResource Text2}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                            <Border Background="#0F141B"
                                BorderBrush="#243142"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="6"
                                SnapsToDevicePixels="True">
                                <ScrollViewer Margin="0" MaxHeight="320">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>

                        <!-- placeholder when empty text -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SelectedText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Resources>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemBd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background" Value="#162235"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBd" Property="Background" Value="#223046"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>


    <!-- ✅ NEW: Validated ComboBox (modern): красная рамка + tooltip из Validation.Errors -->
    <Style x:Key="DarkComboBoxValidatedStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource DarkComboBoxStyle}">
        <Setter Property="ToolTip">
            <Setter.Value>
                <ToolTip Content="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"
                         Background="#1B2430"
                         Foreground="{StaticResource Text}"
                         BorderBrush="{StaticResource Danger}"
                         BorderThickness="1"
                         Padding="10,6"
                         Placement="Bottom"
                         HasDropShadow="True"/>
            </Setter.Value>
        </Setter>

        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <AdornedElementPlaceholder/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                <Setter Property="ToolTipService.IsEnabled" Value="True"/>
            </Trigger>

            <Trigger Property="Validation.HasError" Value="False">
                <Setter Property="ToolTipService.IsEnabled" Value="False"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
