<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Success">#49D17C</SolidColorBrush>
    <SolidColorBrush x:Key="Danger">#FF5A5A</SolidColorBrush>
    <SolidColorBrush x:Key="DangerRowBg">#2A1212</SolidColorBrush>
    <!-- Brushes -->
    <SolidColorBrush x:Key="Bg">#0E1116</SolidColorBrush>
    <SolidColorBrush x:Key="Panel">#141A22</SolidColorBrush>
    <SolidColorBrush x:Key="Panel2">#10151C</SolidColorBrush>
    <SolidColorBrush x:Key="Text">#E6E9EF</SolidColorBrush>
    <SolidColorBrush x:Key="Text2">#AAB3C2</SolidColorBrush>
    <SolidColorBrush x:Key="Accent">#4DA3FF</SolidColorBrush>

    <!-- Nav ListBox -->
    <Style x:Key="NavListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Nav Item (активный/hover) -->
    <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="14,0,14,0"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Акцентная полоска -->
                            <Border x:Name="Bar" Grid.Column="0"
                                    Background="Transparent"
                                    CornerRadius="10,0,0,10"/>

                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1B2430"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#223046"/>
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Accent}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- searchbox-->
    <Style x:Key="SearchBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="#0F141B"/>
        <Setter Property="BorderBrush" Value="#243142"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,0,12,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>

                            <!-- Watermark -->
                            <TextBlock x:Name="Watermark"
                                   Text="Поиск…"
                                   Foreground="{StaticResource Text2}"
                                   Margin="12,0,12,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar buttons -->
    <Style x:Key="ToolbarButtonBase" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="#0F141B"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="#243142"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                     Background="{TemplateBinding Background}"
                     BorderBrush="{TemplateBinding BorderBrush}"
                     BorderThickness="{TemplateBinding BorderThickness}"
                     CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>

                        <!-- красивое disabled-состояние -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary (Добавить) -->
    <Style x:Key="ToolbarButtonPrimary" TargetType="Button" BasedOn="{StaticResource ToolbarButtonBase}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="#0E1116"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Danger (Удалить) -->
    <Style x:Key="ToolbarButtonDanger" TargetType="Button" BasedOn="{StaticResource ToolbarButtonBase}">
        <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
        <Setter Property="Background" Value="#0F141B"/>
        <Style.Triggers>
            <!-- когда активна — красная заливка -->
            <Trigger Property="IsEnabled" Value="True">
                <Setter Property="Background" Value="{StaticResource Danger}"/>
                <Setter Property="Foreground" Value="#0E1116"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Trigger>

            <!-- когда disabled — мягкая “опасная” подсказка -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#0F141B"/>
                <Setter Property="Foreground" Value="#B86A6A"/>
                <Setter Property="BorderBrush" Value="#5A2A2A"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Restore (Восстановить) -->
    <Style x:Key="ToolbarButtonSuccess" TargetType="Button" BasedOn="{StaticResource ToolbarButtonBase}">
        <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
        <Setter Property="Foreground" Value="{StaticResource Success}"/>
        <Setter Property="Background" Value="#0F141B"/>
        <Style.Triggers>
            <!-- когда активна — зелёная заливка -->
            <Trigger Property="IsEnabled" Value="True">
                <Setter Property="Background" Value="{StaticResource Success}"/>
                <Setter Property="Foreground" Value="#0E1116"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Trigger>

            <!-- disabled — мягкий зелёный -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#0F141B"/>
                <Setter Property="Foreground" Value="#6AB88A"/>
                <Setter Property="BorderBrush" Value="#2A5A3A"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
