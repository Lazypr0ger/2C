<Window x:Class="_2Cclient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="2Cclient"
        Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="{StaticResource Panel2}"
                CornerRadius="18"
                Padding="14">
            <DockPanel LastChildFill="True">

                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="8,6,8,14">
                    <TextBlock Text="2C ПРЕДПРИЯТИЕ"
                               Foreground="{StaticResource Text}"
                               FontSize="20"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Accounting workspace"
                               Foreground="{StaticResource Text2}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- NAV -->
                <ListBox x:Name="NavList"
                         DockPanel.Dock="Top"
                         Style="{StaticResource NavListStyle}"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         SelectionChanged="NavList_SelectionChanged">

                    <ListBoxItem Tag="Directories">
                        <TextBlock Text="Справочники" FontSize="14"/>
                    </ListBoxItem>

                    <ListBoxItem Tag="Operations">
                        <TextBlock Text="Операции" FontSize="14"/>
                    </ListBoxItem>

                    <ListBoxItem Tag="Reports">
                        <TextBlock Text="Отчёты" FontSize="14"/>
                    </ListBoxItem>

                    <ListBoxItem Tag="Ledger">
                        <TextBlock Text="Журнал проводок" FontSize="14"/>
                    </ListBoxItem>
                </ListBox>

                <!-- Bottom info -->
                <Border DockPanel.Dock="Bottom"
                        Background="#0D1218"
                        CornerRadius="14"
                        Padding="12"
                    Margin="0,14,0,0">  
                    <StackPanel>
                        <TextBlock Text="Подключение"
                   Foreground="{StaticResource Text}"
                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="ConnectionStateText"
                   Text="НЕ ПРОВЕРЕНО"
                   Foreground="{StaticResource Text2}"
                   FontWeight="SemiBold"
                   Margin="0,8,0,0"/>

                        <TextBlock x:Name="ConnectionAddressText"
                   Text="—"
                   Foreground="{StaticResource Text2}"
                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>


            </DockPanel>
        </Border>

        <!-- RIGHT CONTENT -->
        <Border Grid.Column="2"
                Background="{StaticResource Panel}"
                CornerRadius="18"
                Padding="18">
            <DockPanel LastChildFill="True">

                <!-- Top bar -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="PageTitleText"
                                   Text="Главное меню"
                                   Foreground="{StaticResource Text}"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Выберите раздел слева"
                                   Foreground="{StaticResource Text2}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <TextBox Grid.Column="1"
                             Style="{StaticResource SearchBoxStyle}"/>
                </Grid>

                <!-- Content -->
                <Frame x:Name="MainFrame"
                       NavigationUIVisibility="Hidden"
                       Background="Transparent"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
