<Page x:Class="_2Cclient.Views.Pages.OperationListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="Период:"
                           Foreground="{StaticResource Text2}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <DatePicker x:Name="FromDate" Width="150" Margin="0,0,8,0"/>
                <TextBlock Text="—" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="ToDate" Width="150" Margin="0,0,12,0"/>

                <TextBox x:Name="SearchBox"
                         Width="360"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Background="#0F141B"
                         Foreground="{StaticResource Text}"
                         BorderBrush="#243142"
                         BorderThickness="1"
                         Padding="12,0"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="Поиск по названию/комментарию/ID"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Добавить"
                        Style="{StaticResource ToolbarButtonPrimary}"
                        Margin="0,0,8,0"
                        Click="Add_Click"/>

                <Button x:Name="OpenBtn"
                        Content="Открыть"
                        Style="{StaticResource ToolbarButtonBase}"
                        Margin="0,0,8,0"
                        Click="Open_Click"
                        IsEnabled="False"/>

                <Button x:Name="UpdateBtn"
                        Content="Обновить"
                        Style="{StaticResource ToolbarButtonBase}"
                        Margin="0,0,8,0"
                        Click="Update_Click"
                        IsEnabled="False"/>

                <Button x:Name="DeleteBtn"
                        Content="Удалить"
                        Style="{StaticResource ToolbarButtonDanger}"
                        Margin="0,0,8,0"
                        Click="Delete_Click"
                        IsEnabled="False"/>

                <Button x:Name="RestoreBtn"
                        Content="Восстановить"
                        Style="{StaticResource ToolbarButtonSuccess}"
                        Click="Restore_Click"
                        IsEnabled="False"/>
            </StackPanel>
        </DockPanel>

        <!-- List -->
        <Border Grid.Row="4" Background="#10151C" CornerRadius="14" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Дата" Foreground="{StaticResource Text2}"/>
                    <TextBlock Grid.Column="1" Text="Название" Foreground="{StaticResource Text2}"/>
                    <TextBlock Grid.Column="2" Text="Комментарий" Foreground="{StaticResource Text2}"/>
                    <TextBlock Grid.Column="3" Text="Сумма" Foreground="{StaticResource Text2}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="Статус" Foreground="{StaticResource Text2}" HorizontalAlignment="Right"/>
                </Grid>

                <ListView x:Name="List"
                          Grid.Row="2"
                          Background="Transparent"
                          BorderThickness="0"
                          Margin="0,6,0,0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionChanged="List_SelectionChanged"
                          PreviewMouseDown="List_PreviewMouseDown">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,4,0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd"
                                                Background="#0F141B"
                                                BorderBrush="#243142"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12">
                                            <ContentPresenter/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerRowBg}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
                                            </DataTrigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>

                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#162235"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDeleted}" Value="True"/>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerRowBg}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding DateLocalText}" Foreground="{StaticResource Text}" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="{Binding NameDocument}"
                                           Foreground="{StaticResource Text}" FontSize="14"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding Comment}"
                                           Foreground="{StaticResource Text2}"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding TotalAmountDocument, StringFormat={}{0:N2}}"
                                           Foreground="{StaticResource Text}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"/>

                                <TextBlock Grid.Column="4"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Активно"/>
                                            <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                    <Setter Property="Text" Value="Удалён"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>
            </Grid>
        </Border>

        <Button Grid.Row="6"
                Content="Назад"
                Height="40"
                Style="{StaticResource ToolbarButtonBase}"
                Click="Back_Click"/>
    </Grid>
</Page>
