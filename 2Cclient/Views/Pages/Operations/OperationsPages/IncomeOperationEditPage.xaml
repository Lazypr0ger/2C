<Page x:Class="_2Cclient.Views.Pages.Operations.OperationsPages.IncomeOperationEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Поступление на склад"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Документ Дт43 Кт20"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Шапка -->
                <Border Background="{StaticResource Panel2}"
                        CornerRadius="14"
                        Padding="14">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="12"/>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="12"/>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="12"/>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Name -->
                        <TextBlock Grid.Row="0"
                                   Text="Название документа"
                                   Foreground="{StaticResource Text2}"
                                   Margin="2,0,0,0"/>

                        <TextBox Grid.Row="2"
                                 x:Name="NameDocumentBox"
                                 Style="{StaticResource FormTextBoxValidatedStyle}"
                                 MaxLength="200"
                                 PreviewTextInput="NameDocumentBox_PreviewTextInput"
                                 TextChanged="NameDocumentBox_TextChanged"/>

                        <!-- Date + Time -->
                        <TextBlock Grid.Row="4"
                                   Text="Дата и время"
                                   Foreground="{StaticResource Text2}"
                                   Margin="2,0,0,0"/>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <DatePicker x:Name="DatePicker"
                                            Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBox x:Name="TimeBox"
                                         Style="{StaticResource FormTextBoxValidatedStyle}"
                                         MaxLength="5"
                                         PreviewKeyDown="TimeBox_PreviewKeyDown"
                                         PreviewTextInput="TimeBox_PreviewTextInput"
                                         TextChanged="TimeBox_TextChanged"
                                         LostFocus="TimeBox_LostFocus"
                                         ToolTip="HH:mm"/>
                            </StackPanel>
                        </Grid>

                        <!-- Departament -->
                        <TextBlock Grid.Row="8"
                                   Text="Подразделение"
                                   Foreground="{StaticResource Text2}"
                                   Margin="2,0,0,0"/>

                        <ComboBox Grid.Row="10"
                                  x:Name="DepartamentBox"
                                  Style="{StaticResource DarkComboBoxValidatedStyle}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  IsEditable="False"
                                  SelectionChanged="DepartamentBox_SelectionChanged"/>

                        <!-- Comment -->
                        <TextBlock Grid.Row="12"
                                   Text="Комментарий"
                                   Foreground="{StaticResource Text2}"
                                   Margin="2,0,0,0"/>

                        <TextBox Grid.Row="14"
                                 x:Name="CommentBox"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 MaxLength="400"/>
                    </Grid>
                </Border>

                <Border Height="12" Background="Transparent"/>

                <!-- Состав -->
                <Border Background="{StaticResource Panel2}"
                        CornerRadius="14"
                        Padding="14">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Состав документа"
                                   Foreground="{StaticResource Text}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <!-- Add row -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ProductBox"
                                      Grid.Column="0"
                                      Style="{StaticResource DarkComboBoxValidatedStyle}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      IsEditable="False"/>

                            <TextBox x:Name="CountBox"
                                     Grid.Column="2"
                                     Style="{StaticResource FormTextBoxValidatedStyle}"
                                     MaxLength="9"
                                     VerticalContentAlignment="Center"
                                     PreviewKeyDown="CountBox_PreviewKeyDown"
                                     PreviewTextInput="CountBox_PreviewTextInput"
                                     TextChanged="CountBox_TextChanged"
                                     ToolTip="Целое число > 0"/>

                            <Button Grid.Column="4"
                                    Content="Добавить"
                                    Style="{StaticResource ToolbarButtonPrimary}"
                                    MinWidth="160"
                                    Click="AddRow_Click"/>
                        </Grid>

                        <!-- Table -->
                        <Grid Grid.Row="4" Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="4,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Продукт" Foreground="{StaticResource Text2}"/>
                                <TextBlock Grid.Column="1" Text="Количество" Foreground="{StaticResource Text2}"/>
                                <TextBlock Grid.Column="2" Text="" Foreground="{StaticResource Text2}"/>
                            </Grid>

                            <ListView x:Name="ItemsList"
                                      Grid.Row="2"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Margin="0,6,0,0"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,4,0,4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="Bd"
                                                            Background="#0F141B"
                                                            BorderBrush="#243142"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="12">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#162235"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="64"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding ProductionName}"
                                                       Foreground="{StaticResource Text}"
                                                       FontSize="14"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CountElement}"
                                                       Foreground="{StaticResource Text}"/>

                                            <Button Grid.Column="2"
                                                    Style="{StaticResource RowDeleteButtonStyle}"
                                                    Click="RowDelete_Click"
                                                    Tag="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Назад"
                    Height="40"
                    Style="{StaticResource ToolbarButtonBase}"
                    Click="Back_Click"/>

            <Button x:Name="SaveBtn"
                    Grid.Column="3"
                    Content="Сохранить"
                    Height="40"
                    Style="{StaticResource ToolbarButtonPrimary}"
                    Click="Save_Click"/>
        </Grid>
    </Grid>
</Page>
