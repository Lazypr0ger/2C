<Page x:Class="_2Cclient.Views.Pages.Operations.OperationsPages.WriteOffDeviationOperationEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Списание отклонений"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Операция месяца (сервер формирует проводки)"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Card -->
        <Border Grid.Row="2"
                Background="{StaticResource Panel2}"
                CornerRadius="14"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Name -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Название документа"
                               Foreground="{StaticResource Text2}"
                               Margin="2,0,0,6"/>
                    <TextBox x:Name="NameDocumentBox"
                             Style="{StaticResource FormTextBoxValidatedStyle}"
                             MaxLength="200"
                             PreviewTextInput="NameDocumentBox_PreviewTextInput"
                             TextChanged="NameDocumentBox_TextChanged"/>
                </StackPanel>

                <!-- Date + Time -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Дата (месяц определяется по дате)"
                                   Foreground="{StaticResource Text2}"
                                   Margin="2,0,0,6"/>
                        <DatePicker x:Name="DatePicker"
                                    Height="34"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Время (HH:mm)"
                                   Foreground="{StaticResource Text2}"
                                   Margin="2,0,0,6"/>
                        <TextBox x:Name="TimeBox"
                                 Style="{StaticResource FormTextBoxValidatedStyle}"
                                 MaxLength="5"
                                 PreviewTextInput="TimeBox_PreviewTextInput"
                                 PreviewKeyDown="TimeBox_PreviewKeyDown"
                                 TextChanged="TimeBox_TextChanged"
                                 LostFocus="TimeBox_LostFocus"
                                 ToolTip="Только формат HH:mm, например 12:00"/>
                    </StackPanel>
                </Grid>

                <!-- Comment -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="Комментарий"
                               Foreground="{StaticResource Text2}"
                               Margin="2,0,0,6"/>
                    <TextBox x:Name="CommentBox"
                             Style="{StaticResource FormTextBoxStyle}"
                             MaxLength="400"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    Content="Назад"
                    Height="40"
                    Style="{StaticResource ToolbarButtonBase}"
                    Click="Back_Click"/>

            <Button x:Name="ApplyBtn"
                    Grid.Column="3"
                    Content="Выполнить"
                    Height="40"
                    Style="{StaticResource ToolbarButtonPrimary}"
                    Click="Apply_Click"/>
        </Grid>
    </Grid>
</Page>
