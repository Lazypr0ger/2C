<Page x:Class="_2Cclient.Views.Pages.Reports.ReportCreatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>

        <!-- Единый стиль Label -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Dark DatePicker без ломания команд -->
        <Style x:Key="DarkDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#0F141B"/>
            <Setter Property="BorderBrush" Value="#243142"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <DatePickerTextBox x:Name="PART_TextBox"
                                                       Grid.Column="0"
                                                       Background="Transparent"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       BorderThickness="0"
                                                       Padding="{TemplateBinding Padding}"
                                                       VerticalContentAlignment="Center"/>

                                    <Button x:Name="PART_Button"
                                            Grid.Column="1"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Focusable="False">
                                        <Path Data="M 0 0 L 6 6 L 12 0 Z"
                                              Fill="{StaticResource Text2}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade">
                                <Border Background="#0F141B"
                                        BorderBrush="#243142"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="6">
                                    <Calendar x:Name="PART_Calendar"
                                              Foreground="{StaticResource Text}"
                                              Background="#0F141B"/>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText"
                       Text="Создание отчёта"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Введите параметры и сформируйте отчёт"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Form Card -->
        <Border Grid.Row="2"
                Background="#10151C"
                CornerRadius="14"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Название отчёта" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="NameBox"
                                 Style="{StaticResource FormTextBoxStyle}"/>

                        <TextBlock Text="Дата от" Style="{StaticResource FormLabel}" Margin="0,14,0,6"/>
                        <DatePicker x:Name="FromDate" Style="{StaticResource DarkDatePicker}"/>

                        <TextBlock Text="Дата по" Style="{StaticResource FormLabel}" Margin="0,14,0,6"/>
                        <DatePicker x:Name="ToDate" Style="{StaticResource DarkDatePicker}"/>
                    </StackPanel>

                    <!-- Right -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Дата формирования" Style="{StaticResource FormLabel}"/>
                        <DatePicker x:Name="BuildDate" Style="{StaticResource DarkDatePicker}"/>

                        <TextBlock Text="Комментарий (опционально)" Style="{StaticResource FormLabel}" Margin="0,14,0,6"/>
                        <TextBox x:Name="CommentBox"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Height="120"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>
                </Grid>

                <!-- Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            Style="{StaticResource ToolbarButtonBase}"
                            Click="Cancel_Click"
                            Margin="0,0,10,0"/>

                    <Button x:Name="BuildBtn"
                            Content="Сформировать"
                            Style="{StaticResource ToolbarButtonPrimary}"
                            Click="Build_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Button Grid.Row="3"
                Content="Назад"
                Height="40"
                Style="{StaticResource ToolbarButtonBase}"
                Click="Back_Click"/>
    </Grid>
</Page>
