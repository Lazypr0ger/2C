<Page x:Class="_2Cclient.Views.Pages.Reports.ReportViewerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{StaticResource Bg}">

    <!--
        Добавил горизонтальный скролл "снизу" (ползунок).
        Таблица живёт внутри ScrollViewer с HorizontalScrollBarVisibility="Auto".
        Вертикальный скролл тоже включён, чтобы можно было смотреть длинные отчёты.
    -->

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource ToolbarButtonBase}"
                        MinWidth="44"
                        Width="44"
                        Padding="0"
                        Content="←"
                        Click="Back_Click"/>

                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock x:Name="TitleText"
                               Foreground="{StaticResource Text}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="Отчёт"/>

                    <TextBlock x:Name="PeriodText"
                               Foreground="{StaticResource Text2}"
                               FontSize="13"
                               Margin="0,4,0,0"
                               Text="за период"/>

                    <TextBlock x:Name="ExtraLineText"
                               Foreground="{StaticResource Text2}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               Visibility="Collapsed"
                               Text=""/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButtonBase}"
                            MinWidth="120"
                            Content="Обновить"
                            Margin="0,0,10,0"
                            Click="Reload_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Column headers row label -->
        <Border Grid.Row="1"
                Background="Transparent"
                Padding="4,10,4,6">
            <TextBlock x:Name="TableTitleText"
                       Foreground="{StaticResource Text2}"
                       FontSize="12"
                       Text="Таблица отчёта"/>
        </Border>

        <!-- Table host + bottom horizontal scrollbar -->
        <Border Grid.Row="2"
                Background="Transparent"
                ClipToBounds="True">

            <!-- Ползунок снизу появится автоматически, если контент шире -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          PanningMode="Both"
                          ClipToBounds="True">

               
                <ContentControl x:Name="TableHost"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ClipToBounds="True"/>
            </ScrollViewer>
        </Border>

        <!-- Totals footer -->
        <Border Grid.Row="3"
                Style="{StaticResource CardStyle}"
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="Итоги"
                               Foreground="{StaticResource Text}"
                               FontWeight="SemiBold"
                               FontSize="14"/>

                    <TextBlock x:Name="Total1Text"
                               Foreground="{StaticResource Text2}"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Text=""/>

                    <TextBlock x:Name="Total2Text"
                               Foreground="{StaticResource Text2}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Text=""/>

                    <TextBlock x:Name="Total3Text"
                               Foreground="{StaticResource Text2}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Text=""/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
