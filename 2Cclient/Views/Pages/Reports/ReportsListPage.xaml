<Page x:Class="_2Cclient.Views.Pages.Reports.ReportsListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="SubtitleText"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Card -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBox x:Name="SearchBox"
                                 Width="360"
                                 Style="{StaticResource SearchBoxStyle}"
                                 TextChanged="SearchBox_TextChanged"/>

                        <Button Content="Обновить"
                                Style="{StaticResource ToolbarButtonBase}"
                                Click="Reload_Click"
                                Margin="10,0,0,0"/>

                        <Button Content="Сброс"
                                Style="{StaticResource ToolbarButtonBase}"
                                Click="Reset_Click"
                                Margin="10,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <Button Content="Добавить"
                                Style="{StaticResource ToolbarButtonPrimary}"
                                Click="Add_Click"
                                Margin="0,0,8,0"/>

                        <Button x:Name="OpenBtn"
                                Content="Открыть"
                                Style="{StaticResource ToolbarButtonBase}"
                                Click="Open_Click"
                                IsEnabled="False"
                                Margin="0,0,8,0"/>

                        <Button x:Name="DeleteBtn"
                                Content="Удалить"
                                Style="{StaticResource ToolbarButtonDanger}"
                                Click="Delete_Click"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>

                <!-- Table -->
                <ContentControl Grid.Row="2">
                    <ListView x:Name="ReportsList"
                              Style="{StaticResource ReportTableListStyle}"
                              Margin="0"
                              SelectionChanged="ReportsList_SelectionChanged"
                              PreviewMouseDown="ReportsList_PreviewMouseDown">

                        <!-- если в Theme стиль строки называется иначе:
                             1) если у тебя ReportRowStyle — поменяй ключ ниже
                             2) если ты уже задаёшь ItemContainerStyle в ReportTableListStyle — можно убрать эту строку -->
                        <ListView.ItemContainerStyle>
                            <StaticResource ResourceKey="ReportTableRowStyle"/>
                        </ListView.ItemContainerStyle>

                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource ReportGridHeaderStyle}">

                                <GridViewColumn Header="Название" Width="420">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource ReportCellTextStyle}"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Период" Width="260">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource ReportCellTextStyle}"
                                                       Foreground="{StaticResource Text2}"
                                                       Text="{Binding PeriodText}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Дата формирования" Width="190">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource ReportCellTextStyle}"
                                                       Text="{Binding BuildDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Создан" Width="190">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource ReportCellTextStyle}"
                                                       Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Статус" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource ReportCellTextStyle}"
                                                       Text="{Binding Status}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Комментарий" Width="420">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource ReportCellTextStyle}"
                                                       Foreground="{StaticResource Text2}"
                                                       Text="{Binding Comment}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                            </GridView>
                        </ListView.View>
                    </ListView>
                </ContentControl>
            </Grid>
        </Border>

        <!-- Bottom -->
        <Button Grid.Row="4"
                Content="Назад"
                Height="40"
                Style="{StaticResource ToolbarButtonBase}"
                Click="Back_Click"/>
    </Grid>
</Page>
