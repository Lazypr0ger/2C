<Page x:Class="_2Cclient.Views.Pages.OperationsPages.ManualPostingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText"
                       Text="Ручная проводка (Дт20 Кт10)"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Введите параметры и нажмите «Провести»"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Body -->
        <Border Grid.Row="2"
                Background="{StaticResource Panel2}"
                CornerRadius="14"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="12"/>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="12"/>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="12"/>

                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Название документа" Foreground="{StaticResource Text2}"/>
                <TextBox Grid.Row="2"
                         x:Name="NameDocumentBox"
                         Style="{StaticResource FormTextBoxStyle}"/>

                <TextBlock Grid.Row="4" Text="Дата операции" Foreground="{StaticResource Text2}"/>
                <DatePicker Grid.Row="6"
                            x:Name="DateOperationPicker"/>

                <TextBlock Grid.Row="8" Text="Подразделение (аналитика сч.20)" Foreground="{StaticResource Text2}"/>
                <ComboBox Grid.Row="10"
                          x:Name="DepartamentBox"
                          Style="{StaticResource DarkComboBoxStyle}"
                          Width="320"
                          HorizontalAlignment="Left"/>

                <TextBlock Grid.Row="12" Text="Сумма" Foreground="{StaticResource Text2}"/>
                <TextBox Grid.Row="14"
                         x:Name="AmountBox"
                         Style="{StaticResource FormTextBoxStyle}"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Назад"
                    Style="{StaticResource ToolbarButtonBase}"
                    Click="Back_Click"
                    Margin="0,0,8,0"/>
            <Button x:Name="PostBtn"
                    Content="Провести"
                    Style="{StaticResource ToolbarButtonPrimary}"
                    Click="Post_Click"/>
        </StackPanel>
    </Grid>
</Page>
