<Page x:Class="_2Cclient.Views.Pages.ManualPostingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Ручная проводка"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Операция: Дт 20 — Кт 10 (Накопление фактических затрат)"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#10151C" CornerRadius="14" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Дата" Foreground="{StaticResource Text2}" Margin="0,0,0,6"/>
                    <DatePicker x:Name="DateBox" Width="220"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Подразделение" Foreground="{StaticResource Text2}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="DepartamentBox"
                              Width="420"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"/>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="Сумма" Foreground="{StaticResource Text2}" Margin="0,0,0,6"/>
                    <TextBox x:Name="AmountBox"
                             Width="220"
                             Height="38"
                             VerticalContentAlignment="Center"
                             Background="#0F141B"
                             Foreground="{StaticResource Text}"
                             BorderBrush="#243142"
                             BorderThickness="1"
                             Padding="12,0"/>
                </StackPanel>

                <StackPanel Grid.Row="6">
                    <TextBlock Text="Комментарий" Foreground="{StaticResource Text2}" Margin="0,0,0,6"/>
                    <TextBox x:Name="CommentBox"
                             Height="38"
                             VerticalContentAlignment="Center"
                             Background="#0F141B"
                             Foreground="{StaticResource Text}"
                             BorderBrush="#243142"
                             BorderThickness="1"
                             Padding="12,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <Button Content="Отмена"
                    Style="{StaticResource ToolbarButtonBase}"
                    Width="160"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Провести"
                    Style="{StaticResource ToolbarButtonPrimary}"
                    Width="180"
                    Height="40"
                    Click="Save_Click"/>
        </DockPanel>
    </Grid>
</Page>
