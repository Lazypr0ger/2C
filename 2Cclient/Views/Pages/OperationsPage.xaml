<Page x:Class="_2Cclient.Views.Pages.OperationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Операции"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Выберите вид операции"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="2">

            <Button Click="ActualCosts_Click" Margin="0,0,12,12"
                    Background="#10151C" BorderBrush="#243142" BorderThickness="1" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="18">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

                <StackPanel>
                    <TextBlock Text="Фактические затраты"
                               Foreground="{StaticResource Text}"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Документ: Дт20 Кт10"
                               Foreground="{StaticResource Text2}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Button>

            <Button Click="Receipt_Click" Margin="12,0,0,12"
                    Background="#10151C" BorderBrush="#243142" BorderThickness="1" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="18">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

                <StackPanel>
                    <TextBlock Text="Поступление на склад"
                               Foreground="{StaticResource Text}"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Документ: Дт43 Кт20"
                               Foreground="{StaticResource Text2}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Button>

            <Button Click="Sale_Click" Margin="0,12,12,0"
                    Background="#10151C" BorderBrush="#243142" BorderThickness="1" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="18">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

                <StackPanel>
                    <TextBlock Text="Реализация продукции"
                               Foreground="{StaticResource Text}"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Документ: Дт62 Кт90 / Дт90 Кт43"
                               Foreground="{StaticResource Text2}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Button>

            <StackPanel>
                <Button Click="Allocate_Click" Margin="12,12,0,12"
                        Background="#10151C" BorderBrush="#243142" BorderThickness="1" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="16"
                                    Padding="18">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                    <StackPanel>
                        <TextBlock Text="Распределение фактической себестоимости"
                                   Foreground="{StaticResource Text}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Операция месяца: Дт43 Кт20"
                                   Foreground="{StaticResource Text2}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>

                <Button Click="WriteOff_Click" Margin="12,0,0,0"
                        Background="#10151C" BorderBrush="#243142" BorderThickness="1" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="16"
                                    Padding="18">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                    <StackPanel>
                        <TextBlock Text="Списание отклонений"
                                   Foreground="{StaticResource Text}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Операция месяца: Дт90 Кт43"
                                   Foreground="{StaticResource Text2}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </UniformGrid>
    </Grid>
</Page>
