<Page x:Class="_2Cclient.Views.Pages.OperationsPages.WriteOffDeviationOperationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Операции: Списание отклонений от фактической себестоимости"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Список операций списания отклонений"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <DockPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Создать"
                        Style="{StaticResource ToolbarButtonPrimary}"
                        Margin="0,0,8,0"
                        Click="Create_Click"/>

                <Button x:Name="RepostBtn"
                        Content="Перепровести"
                        Style="{StaticResource ToolbarButtonBase}"
                        Margin="0,0,8,0"
                        Click="Repost_Click"
                        IsEnabled="False"/>

                <Button x:Name="DeleteBtn"
                        Content="Удалить"
                        Style="{StaticResource ToolbarButtonDanger}"
                        Margin="0,0,8,0"
                        Click="Delete_Click"
                        IsEnabled="False"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="4"
                Background="#10151C"
                CornerRadius="14"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="4,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.6*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Документ"
                               Foreground="{StaticResource Text2}"
                               Padding="0,0,12,0"/>
                    <TextBlock Grid.Column="1"
                               Text="Дата"
                               Foreground="{StaticResource Text2}"
                               Padding="0,0,12,0"/>
                    <TextBlock Grid.Column="2"
                               Text="Статус"
                               Foreground="{StaticResource Text2}"/>
                </Grid>

                <ListView x:Name="OperationsList"
                          Grid.Row="2"
                          MinWidth="1100"
                          Background="Transparent"
                          BorderThickness="0"
                          Margin="0,6,0,0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionChanged="List_SelectionChanged"
                          PreviewMouseDown="List_PreviewMouseDown">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,4,0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd"
                                                Background="#0F141B"
                                                BorderBrush="#243142"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12">
                                            <ContentPresenter/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerRowBg}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
                                            </DataTrigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>

                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#162235"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDeleted}" Value="True"/>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerRowBg}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.6*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding NameDocument}"
                                           Foreground="{StaticResource Text}"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"
                                           Padding="0,0,12,0"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding DateOperation, StringFormat={}{0:dd.MM.yyyy}}"
                                           Foreground="{StaticResource Text}"
                                           TextTrimming="CharacterEllipsis"
                                           Padding="0,0,12,0"/>

                                <TextBlock Grid.Column="2"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Проведён"/>
                                            <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                    <Setter Property="Text" Value="Удалён"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Button Grid.Row="6"
                Content="Назад"
                Height="40"
                Style="{StaticResource ToolbarButtonBase}"
                Click="Back_Click"/>
    </Grid>
</Page>
