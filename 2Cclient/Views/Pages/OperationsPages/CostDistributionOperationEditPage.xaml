<Page x:Class="_2Cclient.Views.Pages.OperationsPages.CostDistributionOperationEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText"
                       Text="Распределение фактической себестоимости"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Заполните параметры и нажмите «Распределить»"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Border Background="{StaticResource Panel2}"
                        CornerRadius="14"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="12"/>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="12"/>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="12"/>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Название документа" Foreground="{StaticResource Text2}"/>
                        <TextBox Grid.Row="2" x:Name="NameDocumentBox" Style="{StaticResource FormTextBoxStyle}"/>

                        <TextBlock Grid.Row="4" Text="Дата операции" Foreground="{StaticResource Text2}"/>
                        <DatePicker Grid.Row="6" x:Name="DateOperationPicker"/>

                        <TextBlock Grid.Row="8" Text="Подразделение" Foreground="{StaticResource Text2}"/>
                        <ComboBox Grid.Row="10"
                                  x:Name="DepartamentBox"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  Width="320"
                                  HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="12" Text="Период расчёта" Foreground="{StaticResource Text2}"/>

                        <Grid Grid.Row="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <DatePicker x:Name="StartDatePicker" Grid.Column="0"/>
                            <DatePicker x:Name="EndDatePicker" Grid.Column="2"/>
                        </Grid>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Назад"
                    Style="{StaticResource ToolbarButtonBase}"
                    Click="Back_Click"
                    Margin="0,0,8,0"/>
            <Button x:Name="ApplyBtn"
                    Content="Распределить"
                    Style="{StaticResource ToolbarButtonPrimary}"
                    Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Page>
