<Page x:Class="_2Cclient.Views.Pages.OperationsPages.WriteOffDeviationOperationEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText"
                       Text="Списание отклонений"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Укажите дату операции и нажмите «Списать»"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Название документа"
                               Foreground="{StaticResource Text2}"
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             x:Name="NameDocumentBox"
                             Style="{StaticResource FormTextBoxStyle}"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Дата операции"
                               Foreground="{StaticResource Text2}"
                               VerticalAlignment="Center"/>

                    <DatePicker Grid.Column="1"
                                x:Name="DateOperationPicker"
                                Height="38"/>
                </Grid>

                <TextBlock Grid.Row="4"
                           Foreground="{StaticResource Text2}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Text="Операция выполнит списание отклонений от фактической себестоимости по правилам бухгалтерского расчёта. Проводки в этом окне не отображаются."/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="ExecuteBtn"
                        Content="Списать"
                        Style="{StaticResource ToolbarButtonPrimary}"
                        Margin="0,0,8,0"
                        Click="Execute_Click"/>

                <Button Content="Назад"
                        Height="40"
                        Style="{StaticResource ToolbarButtonBase}"
                        Click="Back_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Page>
