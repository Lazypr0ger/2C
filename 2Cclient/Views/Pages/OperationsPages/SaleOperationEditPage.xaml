<Page x:Class="_2Cclient.Views.Pages.OperationsPages.SaleOperationEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Реализация продукции"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Заполнение документа реализации"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Шапка -->
                <Border Background="{StaticResource Panel2}" CornerRadius="14" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="12"/>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="12"/>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Название документа" Foreground="{StaticResource Text2}"/>
                        <TextBox Grid.Row="2" x:Name="NameDocumentBox" Style="{StaticResource FormTextBoxStyle}"/>

                        <TextBlock Grid.Row="4" Text="Дата операции" Foreground="{StaticResource Text2}"/>
                        <DatePicker Grid.Row="6" x:Name="DateOperationPicker"/>

                        <TextBlock Grid.Row="8" Text="Организация / Контрагент" Foreground="{StaticResource Text2}"/>
                        <ComboBox Grid.Row="10"
                                  x:Name="OrganisationBox"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  Width="320"
                                  HorizontalAlignment="Left"/>
                    </Grid>
                </Border>

                <Border Height="12" Background="Transparent"/>

                <!-- Состав -->
                <Border Background="{StaticResource Panel2}" CornerRadius="14" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Состав документа"
                                   Foreground="{StaticResource Text}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <!-- Ввод -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <!-- Продукт -->
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="220"/>
                                <!-- Склад -->
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="140"/>
                                <!-- Кол-во -->
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                                <!-- Цена -->
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                                <!-- Добавить -->
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ProductBox"
                                      Grid.Column="0"
                                      Style="{StaticResource DarkComboBoxStyle}"
                                      MinWidth="220"/>

                            <TextBox x:Name="WarehouseBox"
                                      Grid.Column="2"
                                      Style="{StaticResource FormTextBoxStyle}"
                                      MinWidth="220"/>

                            <TextBox x:Name="CountBox"
                                     Grid.Column="4"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     MinWidth="140"/>

                            <TextBox x:Name="PriceBox"
                                     Grid.Column="6"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     MinWidth="160"/>

                            <Button Grid.Column="8"
                                    Content="Добавить"
                                    Style="{StaticResource ToolbarButtonPrimary}"
                                    MinWidth="160"
                                    Click="AddRow_Click"/>      
                        </Grid>

                        <!-- Таблица -->
                        <Grid Grid.Row="4" Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="4,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Продукт" Foreground="{StaticResource Text2}"/>
                                <TextBlock Grid.Column="1" Text="Количество" Foreground="{StaticResource Text2}"/>
                                <TextBlock Grid.Column="2" Text="Цена реализации" Foreground="{StaticResource Text2}"/>
                                <TextBlock Grid.Column="3" Text="Сумма" Foreground="{StaticResource Text2}"/>
                                <TextBlock Grid.Column="4" Text="" Foreground="{StaticResource Text2}"/>
                            </Grid>

                            <ListView x:Name="ItemsList"
                                      Grid.Row="2"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Margin="0,6,0,0"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,4,0,4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="Bd"
                                                            Background="#0F141B"
                                                            BorderBrush="#243142"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="12">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#162235"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="64"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding ProductName}" Foreground="{StaticResource Text}" FontSize="14"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{StaticResource Text}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Price}" Foreground="{StaticResource Text}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Sum}" Foreground="{StaticResource Text}"/>

                                            <Button Grid.Column="4"
                                                    Style="{StaticResource RowDeleteButtonStyle}"
                                                    Click="RowDelete_Click"
                                                    Tag="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Итого по документу:"
                                       Foreground="{StaticResource Text2}"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     x:Name="TotalBox"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     IsReadOnly="True"/>
                        </Grid>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Назад"
                    Style="{StaticResource ToolbarButtonBase}"
                    Margin="0,0,8,0"
                    Click="Back_Click"/>

            <Button Content="Сохранить"
                    Style="{StaticResource ToolbarButtonPrimary}"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Page>
