<Page x:Class="_2Cclient.Views.Pages.TransactionLogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>

        <!-- Header for GridView -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#0F141B"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="BorderBrush" Value="#243142"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Row style that DOES NOT break GridView -->
        <Style x:Key="TxRowStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd"
                                Background="#0F141B"
                                BorderBrush="#243142"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8"
                                SnapsToDevicePixels="True">
                            <!-- IMPORTANT: GridViewRowPresenter, иначе будет ToString() -->
                            <GridViewRowPresenter
                                Columns="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=View.Columns}"
                                Content="{TemplateBinding Content}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerRowBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
                            </DataTrigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#162235"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDeleted}" Value="True"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerRowBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text cell styles -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="CellTextRight" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="CellTextMuted" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Журнал проводок"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Проводки с расшифровкой аналитики"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Card -->
        <Border Grid.Row="2"
                Background="#10151C"
                CornerRadius="14"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBlock Text="Период:"
                                   Foreground="{StaticResource Text2}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <DatePicker x:Name="FromDate"
                                    Width="140"
                                    Margin="0,0,8,0"/>

                        <TextBlock Text="—"
                                   Foreground="{StaticResource Text2}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <DatePicker x:Name="ToDate"
                                    Width="140"
                                    Margin="0,0,12,0"/>

                        <TextBox x:Name="SearchBox"
                                 Width="320"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 Background="#0F141B"
                                 Foreground="{StaticResource Text}"
                                 BorderBrush="#243142"
                                 BorderThickness="1"
                                 Padding="12,0"
                                 TextChanged="SearchBox_TextChanged"
                                 ToolTip="Поиск по комментарию/счетам/аналитике"
                                 Margin="0,0,10,0"/>

                        <Button Content="Обновить"
                                Style="{StaticResource ToolbarButtonBase}"
                                Click="Reload_Click"
                                Margin="0,0,10,0"/>

                        <Button Content="Сброс"
                                Style="{StaticResource ToolbarButtonBase}"
                                Click="Reset_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <Button Content="Ручная проводка"
                                Style="{StaticResource ToolbarButtonPrimary}"
                                Click="ManualPosting_Click"
                                Margin="0,0,8,0"/>

                        <Button x:Name="OpenOpBtn"
                                Content="Открыть документ"
                                Style="{StaticResource ToolbarButtonBase}"
                                Click="OpenOperation_Click"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>

                <!-- Table -->
                <ListView x:Name="LogsList"
                          Grid.Row="2"
                          Background="Transparent"
                          BorderThickness="0"
                          Margin="0,6,0,0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ItemContainerStyle="{StaticResource TxRowStyle}"
                          SelectionChanged="LogsList_SelectionChanged"
                          PreviewMouseDown="LogsList_PreviewMouseDown">

                    <ListView.View>
                        <GridView>

                            <GridViewColumn Width="150">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Click="DateHeader_Click" Tag="Date">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Дата"/>
                                            <TextBlock x:Name="DateHeaderArrow"
                                                       Text=" ▼"
                                                       Foreground="{StaticResource Text2}"
                                                       FontWeight="SemiBold"/>  
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>

                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellText}"
                                                   Text="{Binding DateOperation, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>


                            <!-- Дт/Кт только номер -->
                            <GridViewColumn Header="Дт" Width="50">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellText}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ChartDebNum}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Субконто Дт" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellText}"
                                                   Text="{Binding Subconto1DebName}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Кт" Width="50">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellText}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ChartCredNum}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Субконто Кт" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellText}"
                                                   Text="{Binding Subconto1CredName}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Вариант 1 по суммам -->
                            <GridViewColumn Header="Сумма Дт" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellTextRight}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Amount, StringFormat={}{0:N2}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Сумма Кт" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellTextRight}"
                                                   Foreground="{StaticResource Text2}"
                                                   Text=""/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Общая" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellTextRight}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Amount, StringFormat={}{0:N2}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Кол-во" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellTextRight}"
                                                   Text="{Binding Count}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Комментарий" Width="420">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellTextMuted}"
                                                   Text="{Binding Comment}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <Button Grid.Row="4"
                Content="Назад"
                Height="40"
                Style="{StaticResource ToolbarButtonBase}"
                Click="Back_Click"/>
    </Grid>
</Page>
