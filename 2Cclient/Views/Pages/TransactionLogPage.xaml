<Page x:Class="_2Cclient.Views.Pages.TransactionLogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>

        <!-- Header for GridView -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#0F141B"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="BorderBrush" Value="#243142"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Centered header content (IMPORTANT: BasedOn общий стиль, чтобы не было белого фона) -->
        <Style x:Key="HeaderCenter" TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#0F141B"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="BorderBrush" Value="#243142"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- Row style that DOES NOT break GridView -->
        <Style x:Key="TxRowStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd"
                                Background="#0F141B"
                                BorderBrush="#243142"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter
                                Columns="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=View.Columns}"
                                Content="{TemplateBinding Content}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerRowBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
                            </DataTrigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#162235"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDeleted}" Value="True"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerRowBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text cell styles -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="CellTextCenter" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CellTextMuted" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Журнал проводок"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Проводки с расшифровкой аналитики"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Card -->
        <Border Grid.Row="2"
                Background="#10151C"
                CornerRadius="14"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar (2 rows) -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: period + search + apply/reset (растягиваем кнопки) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <!-- Период -->
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <!-- Поиск (растягиваемый) -->
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="200"/>
                            <!-- Применить -->
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="200"/>
                            <!-- Сброс -->
                        </Grid.ColumnDefinitions>

                        <!-- Period -->
                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Период:"
                                       Foreground="{StaticResource Text2}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <DatePicker x:Name="FromDate" Width="150" Margin="0,0,8,0"/>
                            <TextBlock Text="—" Foreground="{StaticResource Text2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="ToDate" Width="150" Margin="0,0,12,0"/>
                        </StackPanel>

                        <!-- Период (оставь как у тебя) -->

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="2"
                                 Style="{StaticResource SearchBoxStyle}"
                                 Height="34"
                                 VerticalContentAlignment="Center"
                                 HorizontalAlignment="Stretch"
                                 MinWidth="260"
                                 MaxWidth="520"
                                 Margin="0"
                                 TextChanged="SearchBox_TextChanged"
                                 ToolTip="Поиск по комментарию/счетам/аналитике/ID операции"/>

                        <Button x:Name="ApplyBtn"
                                Grid.Column="4"
                                Content="Применить"
                                Style="{StaticResource ToolbarButtonBase}"
                                Height="36"
                                HorizontalAlignment="Stretch"
                                Click="Apply_Click"/>

                        <Button Grid.Column="6"
                                Content="Сброс"
                                Style="{StaticResource ToolbarButtonBase}"
                                Height="36"
                                HorizontalAlignment="Stretch"
                                Click="Reset_Click"/>

                    </Grid>

                    <!-- Row 2: actions (без Обновить) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Ручная проводка"
                                Style="{StaticResource ToolbarButtonPrimary}"
                                MinWidth="180"
                                Click="ManualPosting_Click"/>

                        <Button Grid.Column="2"
                                x:Name="OpenOpBtn"
                                Content="Открыть документ"
                                Style="{StaticResource ToolbarButtonBase}"
                                MinWidth="180"
                                Click="OpenOperation_Click"
                                IsEnabled="False"/>
                    </Grid>
                </Grid>

                <!-- Table -->
                <ListView x:Name="LogsList"
                          Grid.Row="2"
                          Background="Transparent"
                          BorderThickness="0"
                          Margin="0,6,0,0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ItemContainerStyle="{StaticResource TxRowStyle}"
                          SelectionChanged="LogsList_SelectionChanged"
                          PreviewMouseDown="LogsList_PreviewMouseDown">

                    <ListView.View>
                        <GridView>

                            <GridViewColumn Width="150">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Click="DateHeader_Click" Tag="Date">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Дата"/>
                                            <TextBlock x:Name="DateHeaderArrow"
                                                       Text=" ▼"
                                                       Foreground="{StaticResource Text2}"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>

                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellText}"
                                                   Text="{Binding DateOperation, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Дт/Кт -->
                            <GridViewColumn Width="50">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Дт" Style="{StaticResource HeaderCenter}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellTextCenter}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ChartDebNum}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Субконто Дт" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellText}"
                                                   Text="{Binding Subconto1DebName}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="50">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Кт" Style="{StaticResource HeaderCenter}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellTextCenter}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ChartCredNum}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Субконто Кт" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellText}"
                                                   Text="{Binding Subconto1CredName}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Суммы/кол-во по центру -->
                            <GridViewColumn Width="120">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Сумма Дт" Style="{StaticResource HeaderCenter}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellTextCenter}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Amount, StringFormat={}{0:N2}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="120">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Сумма Кт" Style="{StaticResource HeaderCenter}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- НЕ отображаем Amount в Кт -->
                                        <TextBlock Style="{StaticResource CellTextCenter}" Text=""/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="120">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Общая" Style="{StaticResource HeaderCenter}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellTextCenter}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Amount, StringFormat={}{0:N2}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="70">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Кол-во" Style="{StaticResource HeaderCenter}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellTextCenter}"
                                                   Text="{Binding Count}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Комментарий" Width="420">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CellTextMuted}"
                                                   Text="{Binding Comment}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <Button Grid.Row="4"
                Content="Назад"
                Height="40"
                Style="{StaticResource ToolbarButtonBase}"
                Click="Back_Click"/>
    </Grid>
</Page>
