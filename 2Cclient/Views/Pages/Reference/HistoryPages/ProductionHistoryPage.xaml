<Page x:Class="_2Cclient.Views.Pages.Reference.HistoryPages.ProductionHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText"
                       Text="История продукции"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText"
                       Text=""
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <DockPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="MakeActualBtn"
                        Content="Сделать актуальной"
                        Style="{StaticResource ToolbarButtonBase}"
                        Click="MakeActual_Click"
                        IsEnabled="False"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="4" Background="#10151C" CornerRadius="14" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Код" Foreground="{StaticResource Text2}"/>
                    <TextBlock Grid.Column="1" Text="Название" Foreground="{StaticResource Text2}"/>
                    <TextBlock Grid.Column="2" Text="Тип" Foreground="{StaticResource Text2}"/>
                    <TextBlock Grid.Column="3" Text="План. цена" Foreground="{StaticResource Text2}"/>
                    <TextBlock Grid.Column="4" Text="Активно с" Foreground="{StaticResource Text2}"/>
                    <TextBlock Grid.Column="5" Text="Активно по" Foreground="{StaticResource Text2}"/>
                </Grid>

                <ListView x:Name="HistoryList"
                          Grid.Row="2"
                          Background="Transparent"
                          BorderThickness="0"
                          Margin="0,6,0,0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionChanged="History_SelectionChanged">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,4,0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd"
                                                Background="#0F141B"
                                                BorderBrush="#243142"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#162235"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Code}"
                                           Foreground="{StaticResource Text}"
                                           FontSize="14"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           Foreground="{StaticResource Text}"
                                           FontSize="14"/>

                                <TextBlock Grid.Column="2"
                                           Foreground="{StaticResource Text}"
                                           Text="{Binding Type}"/>

                                <TextBlock Grid.Column="3"
                                           Foreground="{StaticResource Text}"
                                           Text="{Binding PlannedCost}"/>

                                <TextBlock Grid.Column="4"
                                           Foreground="{StaticResource Text}"
                                           Text="{Binding ValidFrom, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>

                                <TextBlock Grid.Column="5"
                                           Foreground="{StaticResource Text}"
                                           Text="{Binding ValidTo, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Button Grid.Row="6"
                Content="Назад"
                Height="40"
                Style="{StaticResource ToolbarButtonBase}"
                Click="Back_Click"/>
    </Grid>
</Page>
