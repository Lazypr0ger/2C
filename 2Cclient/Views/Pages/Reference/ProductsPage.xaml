<Page x:Class="_2Cclient.Views.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:enums="clr-namespace:Contracts.Enums;assembly=Contracts"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Справочник: Продукты"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Список продуктов"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <DockPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="AddBtn"
                        Content="Добавить"
                        Style="{StaticResource ToolbarButtonPrimary}"
                        Margin="0,0,8,0"
                        Click="Add_Click"/>

                <Button x:Name="UpdateBtn"
                        Content="Обновить"
                        Style="{StaticResource ToolbarButtonBase}"
                        Margin="0,0,8,0"
                        Click="Update_Click"
                        IsEnabled="False"/>

                <Button x:Name="DeleteBtn"
                        Content="Удалить"
                        Style="{StaticResource ToolbarButtonDanger}"
                        Margin="0,0,8,0"
                        Click="Delete_Click"
                        IsEnabled="False"/>

                <Button x:Name="RestoreBtn"
                        Content="Восстановить"
                        Style="{StaticResource ToolbarButtonSuccess}"
                        Margin="0,0,8,0"
                        Click="Restore_Click"
                        IsEnabled="False"/>

                <Button x:Name="HistoryBtn"
                        Content="История"
                        Style="{StaticResource ToolbarButtonBase}"
                        Margin="0,0,8,0"
                        Click="History_Click"
                        IsEnabled="False"/> 
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="4" Background="#10151C" CornerRadius="14" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Код" Foreground="{StaticResource Text2}"/>
                    <TextBlock Grid.Column="1" Text="Название" Foreground="{StaticResource Text2}"/>
                    <TextBlock Grid.Column="2" Text="Тип" Foreground="{StaticResource Text2}"/>
                    <TextBlock Grid.Column="3" Text="Статус" Foreground="{StaticResource Text2}"/>
                </Grid>

                <ListView x:Name="ProductsList"
                          Grid.Row="2"
                          Background="Transparent"
                          BorderThickness="0"
                          Margin="0,6,0,0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionChanged="List_SelectionChanged"
                          PreviewMouseDown="List_PreviewMouseDown">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,4,0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd"
                                                Background="#0F141B"
                                                BorderBrush="#243142"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12">
                                            <ContentPresenter/>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerRowBg}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
                                            </DataTrigger>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>

                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#162235"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>

                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsDeleted}" Value="True"/>
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerRowBg}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}"/>
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Code}" Foreground="{StaticResource Text}" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="14"/>


                                <TextBlock Grid.Column="2" Foreground="{StaticResource Text2}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="—"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:TypeProduct.None}">
                                                    <Setter Property="Text" Value="— Не выбран —"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:TypeProduct.product_1}">
                                                    <Setter Property="Text" Value="Продукт 1"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:TypeProduct.product_2}">
                                                    <Setter Property="Text" Value="Продукт 2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:TypeProduct.product_3}">
                                                    <Setter Property="Text" Value="Продукт 3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:TypeProduct.product_4}">
                                                    <Setter Property="Text" Value="Продукт 4"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="{x:Static enums:TypeProduct.product_5}">
                                                    <Setter Property="Text" Value="Продукт 5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="3" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Активно"/>
                                            <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                    <Setter Property="Text" Value="Удалён"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Button Grid.Row="6"
                Content="Назад"
                Height="40"
                Style="{StaticResource ToolbarButtonBase}"
                Click="Back_Click"/>
    </Grid>
</Page>
