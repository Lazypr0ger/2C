<Page x:Class="_2Cclient.Views.Pages.OrganisationEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText"
                       Foreground="{StaticResource Text}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText"
                       Foreground="{StaticResource Text2}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Form -->
        <Border Grid.Row="2" Background="{StaticResource Panel2}" CornerRadius="14" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Название" Foreground="{StaticResource Text2}" Margin="0,0,0,6"/>
                    <TextBox x:Name="NameBox"
                             Style="{StaticResource FormTextBoxValidatedStyle}"
                             MaxLength="200"
                             PreviewTextInput="NameBox_PreviewTextInput"
                             TextChanged="NameBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Счёт организации" Foreground="{StaticResource Text2}" Margin="0,0,0,6"/>
                    <TextBox x:Name="AccountBox"
                             Style="{StaticResource FormTextBoxValidatedStyle}"
                             MaxLength="25"
                             PreviewTextInput="AccountBox_PreviewTextInput"
                             TextChanged="AccountBox_TextChanged"
                             ToolTip="Только цифры (например 40702810...)"/>
                </StackPanel>

                <CheckBox Grid.Row="4"
                          x:Name="IsDeletedCheck"
                          Content="Пометить как удалённую (неактивную)"
                          Foreground="{StaticResource Text2}"
                          Margin="2,8,0,0"/>
            </Grid>
        </Border>

        <!-- Actions -->
        <DockPanel Grid.Row="4" LastChildFill="False" HorizontalAlignment="Right">
            <Button Content="Отмена"
                    Style="{StaticResource ToolbarButtonBase}"
                    Width="140"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button x:Name="SaveBtn"
                    Content="Сохранить"
                    Style="{StaticResource ToolbarButtonPrimary}"
                    Width="160"
                    Click="Save_Click"/>
        </DockPanel>
    </Grid>
</Page>
